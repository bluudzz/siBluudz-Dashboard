API_PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIRECTORY=./data

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this secret outside the database and back it up securely. Existing IMAP credentials
# cannot be decrypted if this key is lost or changed.
MAIL_CREDENTIALS_KEY=

# Email that receives the admin role when registering; leave blank to disable admin accounts.
ADMIN_EMAIL=

# Microsoft OAuth2 (required for Outlook / Microsoft 365 IMAP - Basic Auth is disabled by Microsoft).
# Register an app at https://entra.microsoft.com, add a Web redirect URI <APP_ORIGIN>/api/mail/oauth/callback
# and grant delegated IMAP.AccessAsUser.All. Use "common" tenant for personal + work accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# Optional Google OAuth. Set both values to enable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auto Workflow Google Drive: buat OAuth Web client dengan redirect URI
# <APP_ORIGIN>/api/google-drive/callback. Bisa memakai GOOGLE_CLIENT_ID/SECRET
# yang sama bila scope Drive sudah diizinkan pada layar persetujuan Google.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# Optional: model image 9router untuk fitur "Ganti Produk di Foto".
# Harus model berkategori image (lihat GET /v1/models/image). Kosongkan = otomatis pakai model image pertama.
NINEROUTER_IMAGE_MODEL=

# Auto Workflow: alamat HTTPS publik dashboard di VPS. Meta mengambil gambar
# lewat /api/workflow-media/<token-acak>; siapa pun yang memiliki tautan dapat melihat gambar.
PUBLIC_BASE_URL=

# Kunci AES-256-GCM untuk token akun Instagram. Buat dengan perintah yang sama
# seperti MAIL_CREDENTIALS_KEY. Jangan menggantinya setelah akun tersimpan.
SOCIAL_CREDENTIALS_KEY=

# Opsional: versi Graph API Meta yang didukung aplikasi Meta Anda.
META_GRAPH_VERSION=v25.0

# Opsional: app access token dari aplikasi Meta yang menerbitkan token akun.
# Dipakai di backend untuk memeriksa izin Page token saat introspeksi mandiri tidak diizinkan.
# Simpan hanya di server; jangan taruh di JSON workflow atau form akun.
META_APP_ACCESS_TOKEN=
