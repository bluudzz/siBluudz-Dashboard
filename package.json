{
  "name": "website-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "create:admin": "node server/create-admin.js",
    "import:admin-invoices": "node server/import-admin-invoices.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host localhost",
    "start": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "preview": "vite preview",
    "worker:run": "node scripts/opencode-worker.mjs run",
    "worker:status": "node scripts/opencode-worker.mjs status"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@openai/agents": "^0.21.0",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "framer-motion": "^14.4.0",
    "google-auth-library": "^11.2.0",
    "imapflow": "^1.0.189",
    "lucide-react": "^1.54.0",
    "mailparser": "^3.7.4",
    "openai": "^7.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "openai": {
      "google-auth-library": "$google-auth-library"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
